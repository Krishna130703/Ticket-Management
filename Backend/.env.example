# Copy to .env for local reference only — do NOT commit .env
# Spring Boot reads these from the environment (or your IDE run configuration).

# Active profile: dev (H2, default) | prod (PostgreSQL)
SPRING_PROFILES_ACTIVE=dev

# --- PostgreSQL (prod profile only) ---
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/ticketdb
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=
